{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Git and Claude Code hooks run these sources directly with Node's type stripping (no build
    // step, so a fresh worktree is gated too): only erasable syntax and explicit .ts imports.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
